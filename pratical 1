class Student {
    String name;
    int rollNo;
    double marks1, marks2, marks3;

    Student(String name, int rollNo, double m1, double m2, double m3) {
        this.name = name;
        this.rollNo = rollNo;
        this.marks1 = m1;
        this.marks2 = m2;
        this.marks3 = m3;
    }

    double calculateTotal() {
        return marks1 + marks2 + marks3;
    }

    double percentage() {
        return (calculateTotal() / 300.0) * 100;
    }

    void displayDetail() {
        System.out.println("Student Name: " + name);
        System.out.println("Student Roll Number: " + rollNo);
        System.out.println("Subject 1: " + marks1);
        System.out.println("Subject 2: " + marks2);
        System.out.println("Subject 3: " + marks3);
        System.out.println("Total Marks: " + calculateTotal());
        System.out.println("Percentage: " + percentage() + "%");
    }
}

class Main {
    public static void main(String[] args) {
        Student s1 = new Student("Om", 12, 98, 99, 100);
        s1.displayDetail();
        Student s1 = new Student("Shivam", 13, 88, 89, 90);
        s1.displayDetail();
        Student s1 = new Student("Noor", 14, 91, 87, 99);
        s1.displayDetail();
    }
}
